# Local bridge listener host. Keep this loopback-only.
BRIDGE_HOST=127.0.0.1

# IMAP development listener.
BRIDGE_IMAP_PORT=1143

# SMTP development listener and advertised domain.
BRIDGE_SMTP_PORT=2025
BRIDGE_SMTP_DOMAIN=localhost

MAIL_API_URL=http://localhost:3100
BRIDGE_DEV_EMAIL=user@inxt.me
BRIDGE_DEV_TOKEN=user-dev-token
BRIDGE_DEV_ENCRYPTION_PRIVATE_KEY=
BRIDGE_DEV_PUBLIC_KEY=
