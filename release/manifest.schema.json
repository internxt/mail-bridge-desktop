{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/internxt/mail-bridge-desktop/releases/manifest.schema.json",
  "title": "Mail Bridge release manifest",
  "description": "Immutable platform binary artifacts published for one Mail Bridge release.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "artifacts"],
  "properties": {
    "version": {
      "description": "Release version without the leading v, for example 1.2.3.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": { "os": { "const": "windows" }, "arch": { "const": "amd64" } },
            "required": ["os", "arch"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": { "os": { "const": "linux" }, "arch": { "const": "amd64" } },
            "required": ["os", "arch"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": { "os": { "const": "darwin" }, "arch": { "const": "arm64" } },
            "required": ["os", "arch"]
          }
        }
      ]
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "archive", "url", "sha256", "executable"],
      "properties": {
        "os": { "enum": ["windows", "linux", "darwin"] },
        "arch": { "enum": ["amd64", "arm64"] },
        "archive": { "enum": ["zip", "tar.gz"] },
        "url": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "executable": { "enum": ["mail-bridge", "mail-bridge.exe"] }
      },
      "allOf": [
        {
          "if": { "properties": { "os": { "const": "windows" } }, "required": ["os"] },
          "then": {
            "properties": { "archive": { "const": "zip" }, "executable": { "const": "mail-bridge.exe" } }
          },
          "else": {
            "properties": { "archive": { "const": "tar.gz" }, "executable": { "const": "mail-bridge" } }
          }
        },
        {
          "oneOf": [
            {
              "properties": { "os": { "const": "windows" }, "arch": { "const": "amd64" } },
              "required": ["os", "arch"]
            },
            {
              "properties": { "os": { "const": "linux" }, "arch": { "const": "amd64" } },
              "required": ["os", "arch"]
            },
            {
              "properties": { "os": { "const": "darwin" }, "arch": { "const": "arm64" } },
              "required": ["os", "arch"]
            }
          ]
        }
      ]
    }
  }
}
